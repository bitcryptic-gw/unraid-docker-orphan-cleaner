<!--
  Community Applications plugin wrapper for docker.orphan.cleaner.

  Format follows the current Community Apps submission docs
  (https://ca.unraid.net/submit/help/repository-xml and
   https://ca.unraid.net/submit/help/xml-field-reference): root <Plugin>,
   minimum <PluginURL> + <Name>, recommended <Overview>, <Support>, <Project>,
   <Category> and <Icon>.

  The <PluginURL> here must match the pluginURL attribute in the .plg exactly.

  Lives at plugins/docker.orphan.cleaner.xml, the layout the maintained CA
  starter repository uses, so this repository can be submitted directly at
  https://ca.unraid.net/submit/new.

  Screenshots are optional and are omitted for now; <Screenshot> entries can be
  added later once they are captured and hosted.
-->
<Plugin>
  <Name>Docker Orphan Cleaner</Name>
  <Overview>
    Lists Docker images that no container references (orphan images) and removes
    the selected ones in bulk, instead of one at a time from the Docker tab.
    Superseded pulls are included. Each orphan is classified as pinned, template
    referenced, compose referenced, tagged or untagged, and only untagged images
    are selected by default. Dry run is on by default and enforced on the
    server, deletions are never forced, and a scheduled run only ever removes
    untagged images past a minimum age. The reclaimable build cache is shown and
    can be pruned on request.
  </Overview>
  <PluginURL>https://raw.githubusercontent.com/bitcryptic-gw/unraid-docker-orphan-cleaner/main/plugin/docker.orphan.cleaner.plg</PluginURL>
  <PluginAuthor>bitcryptic-gw</PluginAuthor>
  <Support>https://forums.unraid.net/topic/200737-docker-orphan-cleaner/</Support>
  <Project>https://github.com/bitcryptic-gw/unraid-docker-orphan-cleaner</Project>
  <ReadMe>https://raw.githubusercontent.com/bitcryptic-gw/unraid-docker-orphan-cleaner/main/README.md</ReadMe>
  <Category>Tools:System</Category>
  <Icon>https://raw.githubusercontent.com/bitcryptic-gw/unraid-docker-orphan-cleaner/main/src/usr/local/emhttp/plugins/docker.orphan.cleaner/images/icon.png</Icon>
  <License>MIT</License>
  <MinVer>7.0.0</MinVer>
  <Beta>false</Beta>
</Plugin>
